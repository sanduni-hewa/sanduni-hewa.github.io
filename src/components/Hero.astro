---
import TechLogo from './TechLogo.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="availability-pill"><span></span> Available for opportunities</p>
    <h1 id="hero-title">Hi, I’m Sanduni.</h1>
    <p class="role-title">Data Engineer<br /><span>& Analytics Engineer</span></p>
    <p class="hero-intro">
      I build scalable data pipelines and turn complex data into reliable, actionable insights with Microsoft Fabric, Databricks, PySpark, SQL, and Power BI.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href="/resume/">View résumé <span aria-hidden="true">↓</span></a>
    </div>
    <div class="social-links" aria-label="Connect with Sanduni">
      <span>Connect with me</span>
      <a href="https://github.com/sanduni-hewa" target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
      <a href="https://linkedin.com/in/sanduni-galbokka-hewa" target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
      <a href="mailto:sandurash19@gmail.com" aria-label="Email">@</a>
    </div>
  </div>
  <aside class="hero-aside" aria-label="Data engineering toolkit and workflow">
    <div class="orbit-stage">
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="portrait-wrap">
        <img src="/images/profile_img.png" alt="Sanduni G. Hewa" width="520" height="520" />
      </div>
      <div class="tech-node tech-sql"><TechLogo name="sql" label="SQL database" /><strong>SQL</strong></div>
      <div class="tech-node tech-python"><TechLogo name="python" label="Python" /><strong>Python</strong></div>
      <div class="tech-node tech-fabric"><TechLogo name="fabric" label="Microsoft Fabric" /><strong>Fabric</strong></div>
      <div class="tech-node tech-databricks"><TechLogo name="databricks" label="Databricks" /><strong>Databricks</strong></div>
      <div class="tech-node tech-powerbi"><TechLogo name="powerbi" label="Power BI" /><strong>Power BI</strong></div>
    </div>
    <div class="pipeline-flow" aria-label="Data workflow: sources, ingest, clean, transform, analyze, insights">
      <span>Sources</span><i></i><span>Ingest</span><i></i><span>Clean</span><i></i><span>Transform</span><i></i><span>Analyze</span><i></i><span>Insights</span>
    </div>
  </aside>
</section>

