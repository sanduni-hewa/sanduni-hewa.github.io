---
import TechLogo from './TechLogo.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="availability-pill"><span></span> Available for opportunities</p>
    <h1 id="hero-title">Turning data into</h1>
    <p class="role-title">Insights <span>& Impact</span></p>
    <p class="hero-intro">
      I build scalable data pipelines and turn complex data into reliable, actionable insights with Microsoft Fabric, Databricks, PySpark, SQL, and Power BI.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href="/resume/">View résumé <span aria-hidden="true">↓</span></a>
    </div>
    <div class="social-links" aria-label="Connect with Sanduni">
      <span>Connect with me</span>
      <a href="https://github.com/sanduni-hewa" target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
      <a href="https://linkedin.com/in/sanduni-galbokka-hewa" target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
      <a href="mailto:sandurash19@gmail.com" aria-label="Email">@</a>
    </div>
  </div>
  <aside class="hero-aside profile-card" aria-label="About Sanduni">
    <div class="profile-card-top">
      <div class="portrait-wrap">
        <img src="/images/profile_img.png" alt="Sanduni G. Hewa" width="520" height="520" />
      </div>
      <div class="profile-intro">
        <p>Hi, I’m</p>
        <h2>Sanduni G. Hewa</h2>
        <span>Data Engineer & Analytics Engineer</span>
      </div>
    </div>
    <ul class="profile-facts">
      <li>Microsoft-certified across Fabric, Power BI, and Azure</li>
      <li>Specialized in Databricks, PySpark, SQL, and lakehouse systems</li>
      <li>Focused on reliable end-to-end data products and measurable outcomes</li>
    </ul>
    <div class="profile-connect">
      <span>Let’s connect</span>
      <a href="https://linkedin.com/in/sanduni-galbokka-hewa" target="_blank" rel="noreferrer">in</a>
      <a href="https://github.com/sanduni-hewa" target="_blank" rel="noreferrer">GH</a>
      <a href="mailto:sandurash19@gmail.com">@</a>
    </div>
  </aside>
</section>

