---
import TechLogo from './TechLogo.astro';
const technologies = [
  ['sql','SQL'],['python','Python'],['spark','PySpark'],['databricks','Databricks'],['fabric','Microsoft Fabric'],['powerbi','Power BI']
] as const;
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">Data Engineer & Analytics Developer</p>
    <h1 id="hero-title">Turning Data into <span>Insights & Impact.</span></h1>
    <p class="hero-intro">I build scalable data pipelines, analytics platforms, automations, and interactive dashboards that turn complex data into useful business insights.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#work">View My Work <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href="#contact">Contact Me <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-technologies">
      <p>Technologies I work with</p>
      <div>
        {technologies.map(([name,label]) => <span><TechLogo name={name} />{label}</span>)}
      </div>
    </div>
  </div>
  <aside class="profile-card" aria-label="About Sanduni">
    <div class="profile-identity">
      <div class="portrait-wrap"><img src="/images/profile_img.png" alt="Sanduni G. Hewa" width="420" height="420" /></div>
      <p>Hi, I’m</p><h2>Sanduni G. Hewa</h2><span>Data Engineer / Analytics Engineer</span>
    </div>
    <div class="profile-details">
      <ul>
        <li>Data Engineering & Analytics</li>
        <li>Microsoft Fabric, Databricks, PySpark, SQL & Power BI</li>
        <li>Building end-to-end data solutions and automations</li>
      </ul>
      <div class="profile-connect">
        <p>Let’s connect</p>
        <a href="https://linkedin.com/in/sanduni-galbokka-hewa" target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
        <a href="https://github.com/sanduni-hewa" target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
        <a href="mailto:sandurash19@gmail.com" aria-label="Email">@</a>
      </div>
    </div>
  </aside>
</section>

