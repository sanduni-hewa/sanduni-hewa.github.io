---
interface Props { title:string; summary:string; image:string; imageAlt:string; href?:string; }
const { title, summary, image, imageAlt, href='#work' } = Astro.props;
---
<article class="small-project">
  <div><h3>{title}</h3><p>{summary}</p><a href={href} aria-label={`View ${title}`}>→</a></div>
  <img src={image} alt={imageAlt} loading="lazy" />
</article>

