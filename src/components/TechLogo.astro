---
interface Props {
  name: 'sql' | 'python' | 'fabric' | 'databricks' | 'powerbi' | 'spark' | 'aws' | 'github' | 'linux';
  label?: string;
}

const { name, label } = Astro.props;

const logos = {
  sql: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/microsoftsqlserver/microsoftsqlserver-original.svg',
    alt: 'Microsoft SQL Server'
  },
  python: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg',
    alt: 'Python'
  },
  fabric: {
    src: 'https://cdn.simpleicons.org/microsoftfabric/5B5FC7',
    alt: 'Microsoft Fabric'
  },
  databricks: {
    src: 'https://cdn.simpleicons.org/databricks/FF3621',
    alt: 'Databricks'
  },
  powerbi: {
    src: 'https://cdn.simpleicons.org/powerbi/F2C811',
    alt: 'Power BI'
  },
  spark: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/apachespark/apachespark-original.svg',
    alt: 'Apache Spark'
  },
  aws: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-plain-wordmark.svg',
    alt: 'Amazon Web Services'
  },
  github: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg',
    alt: 'GitHub'
  },
  linux: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linux/linux-original.svg',
    alt: 'Linux'
  }
} as const;

const logo = logos[name];
---

<span class:list={['tech-logo', `logo-${name}`]}>
  {name === 'fabric' ? (
    <svg viewBox="0 0 48 48" role="img" aria-label={label ?? 'Microsoft Fabric'}>
      <defs>
        <linearGradient id="fabric-a" x1="5" y1="5" x2="43" y2="43" gradientUnits="userSpaceOnUse">
          <stop stop-color="#43E8D8" />
          <stop offset=".48" stop-color="#20B8A5" />
          <stop offset="1" stop-color="#5B5FC7" />
        </linearGradient>
      </defs>
      <path class="brand-fill" fill="url(#fabric-a)" d="M9 7h25.5L42 15.5l-9.5 3.2-8.1 22.1H7.2l8.2-20.6L9 7Zm9.2 14.3-5.1 13h7.2l6.2-16.8-8.3 3.8Z" />
      <path class="brand-fill" fill="#2ED7C5" d="m15.4 20.2 12.3-8.1 14.3 3.4-9.5 3.2-8.1 22.1-4.1-6.5 6.2-16.8-8.3 3.8-2.8-1.1Z" opacity=".82" />
    </svg>
  ) : name === 'powerbi' ? (
    <svg viewBox="0 0 48 48" role="img" aria-label={label ?? 'Power BI'}>
      <rect class="brand-fill" x="5" y="25" width="8" height="18" rx="2.5" fill="#E8A900" />
      <rect class="brand-fill" x="15" y="17" width="8" height="26" rx="2.5" fill="#F2C811" />
      <rect class="brand-fill" x="25" y="9" width="8" height="34" rx="2.5" fill="#F7D633" />
      <rect class="brand-fill" x="35" y="4" width="8" height="39" rx="2.5" fill="#FFE36E" />
    </svg>
  ) : (
    <img src={logo.src} alt={label ?? logo.alt} width="40" height="40" loading="lazy" />
  )}
</span>

