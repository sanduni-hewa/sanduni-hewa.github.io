---
interface Props {
  name: 'sql' | 'python' | 'fabric' | 'databricks' | 'powerbi' | 'spark' | 'aws' | 'github' | 'linux';
  label?: string;
}

const { name, label } = Astro.props;

const logos = {
  sql: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/microsoftsqlserver/microsoftsqlserver-original.svg',
    alt: 'Microsoft SQL Server'
  },
  python: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg',
    alt: 'Python'
  },
  fabric: {
    src: 'https://cdn.simpleicons.org/microsoftfabric/5B5FC7',
    alt: 'Microsoft Fabric'
  },
  databricks: {
    src: 'https://cdn.simpleicons.org/databricks/FF3621',
    alt: 'Databricks'
  },
  powerbi: {
    src: 'https://cdn.simpleicons.org/powerbi/F2C811',
    alt: 'Power BI'
  },
  spark: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/apachespark/apachespark-original.svg',
    alt: 'Apache Spark'
  },
  aws: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-plain-wordmark.svg',
    alt: 'Amazon Web Services'
  },
  github: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg',
    alt: 'GitHub'
  },
  linux: {
    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linux/linux-original.svg',
    alt: 'Linux'
  }
} as const;

const logo = logos[name];
---

<span class:list={['tech-logo', `logo-${name}`]}>
  <img src={logo.src} alt={label ?? logo.alt} width="40" height="40" loading="lazy" />
</span>


